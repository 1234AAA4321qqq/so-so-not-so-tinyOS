#!/bin/bash
set -e

# ============================================================
# 1. Create the live user with autologin
# ============================================================
useradd -m -s /bin/bash -G sudo,audio,video,netdev,plugdev akira || true
echo "akira:akira" | chpasswd
echo "root:root" | chpasswd
echo "akira ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/akira
chmod 0440 /etc/sudoers.d/akira

# ============================================================
# 2. Auto-login on tty1 + auto-start X
# ============================================================
mkdir -p /etc/systemd/system/getty@tty1.service.d
cat > /etc/systemd/system/getty@tty1.service.d/autologin.conf <<EOF
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin akira --noclear %I \$TERM
Type=idle
EOF

cat > /home/akira/.bash_profile <<'EOF'
if [ -z "$DISPLAY" ] && [ "$(tty)" = "/dev/tty1" ]; then
  exec startx
fi
EOF
chown akira:akira /home/akira/.bash_profile

# ============================================================
# 3. Openbox session
# ============================================================
mkdir -p /home/akira/.config/openbox
cat > /home/akira/.config/openbox/autostart <<'EOF'
pcmanfm --desktop &
xsetroot -solid "#1a1a2e" &
EOF
chown -R akira:akira /home/akira/.config

cat > /home/akira/.xinitrc <<'EOF'
#!/bin/sh
exec openbox-session
EOF
chmod +x /home/akira/.xinitrc
chown akira:akira /home/akira/.xinitrc

# ============================================================
# 4. Install autoserver + test1 from GitHub releases
# ============================================================
wget -q -O /usr/local/bin/autoserver \
  https://github.com/tinybinary-idk/autoserver/releases/download/v1.0.0/autoserver-linux-amd64 || true
chmod +x /usr/local/bin/autoserver 2>/dev/null || true

# ============================================================
# 5. Install uv for the akira user
# ============================================================
sudo -u akira bash -c 'curl -LsSf https://astral.sh/uv/install.sh | sh' || true

# ============================================================
# 6. Custom MOTD
# ============================================================
cat > /etc/motd <<'EOF'

  ╔══════════════════════════════════════════╗
  ║     so so not so tinyOS                  ║
  ║                                          ║
  ║     Login: akira    Password: akira      ║
  ║     Root:  root     Password: root       ║
  ╚══════════════════════════════════════════╝

EOF

# ============================================================
# 7. Cleanup
# ============================================================
apt-get clean
rm -rf /var/lib/apt/lists/*